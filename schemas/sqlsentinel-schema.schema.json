{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ljh684/sqlsentinel/schemas/sqlsentinel-schema.schema.json",
  "title": "SQLSentinel schema catalog",
  "description": "Local table, column, index, and foreign-key metadata used by SQL201 and SQL202.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tables"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nameList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "nullable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "columns": {
          "$ref": "#/$defs/nameList"
        },
        "unique": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "references"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "columns": {
          "$ref": "#/$defs/nameList"
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "columns"],
          "properties": {
            "table": {
              "$ref": "#/$defs/name"
            },
            "columns": {
              "$ref": "#/$defs/nameList"
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          }
        },
        "foreignKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foreignKey"
          }
        }
      }
    }
  }
}
